generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  OFFICER
}

enum CheckStatus {
  PASS
  FAIL
}

enum ItemResultStatus {
  PASS
  FAIL
  NA
}

enum CheckFrequency {
  WEEKLY
  MONTHLY
}

enum AlertStatus {
  PENDING
  SENT
  FAILED
}

// --- Auth.js (next-auth v5) Prisma adapter models ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Application models ---

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String
  image         String?
  googleId      String?   @unique
  role          Role      @default(MEMBER)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  submissions CheckSubmission[] @relation("SubmittedBy")

  supplyRequests   SupplyRequest[] @relation("SupplyRequestedBy")
  suppliesReceived SupplyRequest[] @relation("SupplyReceivedBy")
  recordEvents     RecordEvent[]

  workOrdersReported WorkOrder[]     @relation("WorkOrderReportedBy")
  workOrdersResolved WorkOrder[]     @relation("WorkOrderResolvedBy")
  workOrderNotes     WorkOrderNote[]

  loansBorrowed EquipmentLoan[] @relation("LoanBorrower")
  loansApproved EquipmentLoan[] @relation("LoanApprovedBy")
  loansReturned EquipmentLoan[] @relation("LoanReturnedBy")

  @@index([role])
}

model Apparatus {
  id         String   @id @default(cuid())
  name       String
  unitNumber String?  @unique
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  equipmentItems     EquipmentItem[]
  checklistTemplates ChecklistTemplate[]
  submissions        CheckSubmission[]
  workOrders         WorkOrder[]
}

model EquipmentItem {
  id          String     @id @default(cuid())
  name        String
  apparatusId String?
  apparatus   Apparatus? @relation(fields: [apparatusId], references: [id])
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  checklistTemplates ChecklistTemplate[]
  submissions        CheckSubmission[]
  workOrders         WorkOrder[]

  @@index([apparatusId])
}

// A template belongs to exactly one of Apparatus or EquipmentItem
// (enforced in app logic via Zod, not at the DB layer).
model ChecklistTemplate {
  id              String         @id @default(cuid())
  name            String
  apparatusId     String?
  apparatus       Apparatus?     @relation(fields: [apparatusId], references: [id])
  equipmentItemId String?
  equipmentItem   EquipmentItem? @relation(fields: [equipmentItemId], references: [id])
  frequency       CheckFrequency @default(WEEKLY)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  items       ChecklistItem[]
  submissions CheckSubmission[]

  @@index([apparatusId])
  @@index([equipmentItemId])
}

model ChecklistItem {
  id         String            @id @default(cuid())
  templateId String
  template   ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  label      String
  // Heading the item is grouped under when running a check (e.g. "Air brakes").
  section    String?
  sortOrder  Int               @default(0)
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())

  results CheckItemResult[]

  @@index([templateId])
}

// One completed check run.
model CheckSubmission {
  id         String            @id @default(cuid())
  templateId String
  template   ChecklistTemplate @relation(fields: [templateId], references: [id])

  // Denormalized from the template at submission time for fast dashboard filtering.
  apparatusId     String?
  apparatus       Apparatus?     @relation(fields: [apparatusId], references: [id])
  equipmentItemId String?
  equipmentItem   EquipmentItem? @relation(fields: [equipmentItemId], references: [id])

  submittedById String
  submittedBy   User     @relation("SubmittedBy", fields: [submittedById], references: [id])
  submittedAt   DateTime @default(now())

  overallStatus CheckStatus
  notes         String?

  itemResults CheckItemResult[]
  alerts      FailureAlert[]

  @@index([apparatusId, submittedAt])
  @@index([equipmentItemId, submittedAt])
  @@index([submittedById])
  @@index([overallStatus])
}

model CheckItemResult {
  id              String           @id @default(cuid())
  submissionId    String
  submission      CheckSubmission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  checklistItemId String
  checklistItem   ChecklistItem    @relation(fields: [checklistItemId], references: [id])
  status          ItemResultStatus
  note            String?

  workOrders WorkOrder[]

  @@index([submissionId])
  @@index([checklistItemId])
}

// One row per failure-triggered email attempt (audit trail + retry hook).
model FailureAlert {
  id              String          @id @default(cuid())
  submissionId    String
  submission      CheckSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  recipientEmails String[]
  status          AlertStatus     @default(PENDING)
  attempts        Int             @default(0)
  lastError       String?
  sentAt          DateTime?
  createdAt       DateTime        @default(now())

  @@index([submissionId])
  @@index([status])
}

// --- Supply requests ---

// Open: REQUESTED, ORDERED. Closed (archived, still viewable): RECEIVED,
// DENIED, CANCELED. Requests are never deleted.
enum SupplyStatus {
  REQUESTED
  ORDERED
  RECEIVED
  DENIED
  CANCELED
}

model SupplyRequest {
  id            String       @id @default(cuid())
  item          String
  quantity      String // free text so units fit: "2 cases", "24"
  dateNeeded    DateTime?    @db.Date
  notes         String?
  status        SupplyStatus @default(REQUESTED)
  // Why it was denied or canceled.
  statusReason  String?
  requestedById String
  requestedBy   User         @relation("SupplyRequestedBy", fields: [requestedById], references: [id])
  receivedAt    DateTime?
  receivedById  String?
  receivedBy    User?        @relation("SupplyReceivedBy", fields: [receivedById], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status])
  @@index([requestedById])
  @@index([dateNeeded])
}

// --- Change history ---

// One row per change to a request, work order, or loan: who, when, and a
// readable summary ("Status: Requested → Ordered"). Shared by all record
// types, so entityId has no foreign key.
enum RecordType {
  SUPPLY_REQUEST
  WORK_ORDER
  EQUIPMENT_LOAN
}

model RecordEvent {
  id         String     @id @default(cuid())
  entityType RecordType
  entityId   String
  actorId    String
  actor      User       @relation(fields: [actorId], references: [id])
  summary    String
  createdAt  DateTime   @default(now())

  @@index([entityType, entityId, createdAt])
}

// --- Work orders ---

// Missing or damaged equipment. OPEN until an officer resolves it; RESOLVED
// and CANCELED are archived but viewable. Work orders are never deleted.
enum WorkOrderStatus {
  OPEN
  RESOLVED
  CANCELED
}

model WorkOrder {
  id           String          @id @default(cuid())
  title        String
  description  String?
  status       WorkOrderStatus @default(OPEN)
  // Takes the vehicle or equipment out of service while the work order is
  // open. Officers set and clear it.
  outOfService Boolean         @default(false)
  // Resolution summary, or why it was canceled.
  statusReason String?

  // Links are cleared rather than blocking deletes (the checklist import's
  // --reset removes vehicles and check history); the work order is kept.
  apparatusId       String?
  apparatus         Apparatus?       @relation(fields: [apparatusId], references: [id], onDelete: SetNull)
  equipmentItemId   String?
  equipmentItem     EquipmentItem?   @relation(fields: [equipmentItemId], references: [id], onDelete: SetNull)
  // The failed check item it was created from, if any.
  checkItemResultId String?
  checkItemResult   CheckItemResult? @relation(fields: [checkItemResultId], references: [id], onDelete: SetNull)
  // The equipment loan it was created from (returned with an issue), if any.
  loanId            String?
  loan              EquipmentLoan?   @relation(fields: [loanId], references: [id])

  reportedById String
  reportedBy   User      @relation("WorkOrderReportedBy", fields: [reportedById], references: [id])
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?     @relation("WorkOrderResolvedBy", fields: [resolvedById], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  notes WorkOrderNote[]

  @@index([status])
  @@index([apparatusId])
  @@index([equipmentItemId])
  @@index([checkItemResultId])
  @@index([loanId])
}

// Dated progress notes ("replacement ordered", "replaced"). Kept permanently;
// they can't be edited or removed.
model WorkOrderNote {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  body        String
  createdAt   DateTime  @default(now())

  @@index([workOrderId, createdAt])
}

// --- Equipment loans ---

// REQUESTED until an officer approves or denies it; APPROVED while it's out
// (or waiting to go out); RETURNED once an officer verifies the return.
// DENIED and CANCELED are archived too. Loans are never deleted.
enum LoanStatus {
  REQUESTED
  APPROVED
  RETURNED
  DENIED
  CANCELED
}

model EquipmentLoan {
  id         String     @id @default(cuid())
  borrowerId String
  borrower   User       @relation("LoanBorrower", fields: [borrowerId], references: [id])
  status     LoanStatus @default(REQUESTED)
  dateOut    DateTime   @db.Date
  dateDue    DateTime   @db.Date
  notes      String?

  // The responsibility wording the borrower agreed to, as it read then.
  acknowledgement String
  acknowledgedAt  DateTime @default(now())

  // Why it was denied or canceled.
  statusReason String?
  approvedAt   DateTime?
  approvedById String?
  approvedBy   User?     @relation("LoanApprovedBy", fields: [approvedById], references: [id])

  returnedAt        DateTime?
  returnedById      String?
  returnedBy        User?     @relation("LoanReturnedBy", fields: [returnedById], references: [id])
  returnedWithIssue Boolean   @default(false)
  returnNote        String?

  // When the due-today reminder was sent (one per loan; cleared if the return date changes).
  lastReminderAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items      LoanItem[]
  workOrders WorkOrder[]

  @@index([status, dateDue])
  @@index([borrowerId])
}

// One line on a loan: free-text description (no equipment catalog) and how
// many, e.g. "8-ft folding tables" × 3.
model LoanItem {
  id          String        @id @default(cuid())
  loanId      String
  loan        EquipmentLoan @relation(fields: [loanId], references: [id])
  description String
  quantity    Int
  sortOrder   Int           @default(0)

  @@index([loanId])
}
